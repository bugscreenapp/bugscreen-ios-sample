// Copy this file to `Secrets.xcconfig` (same folder) and paste your BugScreen API key.
//
//   cp Config/Secrets.xcconfig.sample Config/Secrets.xcconfig
//
// Then edit Config/Secrets.xcconfig and set your key from https://bugscreen.app:
//
//   BUGSCREEN_API_KEY = fb_your_api_key_here
//
// `Secrets.xcconfig` is git-ignored, so your key never lands in source control. Leaving the
// key blank is fine — the app still builds and the report screen still opens; you just can't
// upload reports.

BUGSCREEN_API_KEY =
